generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  AUTHOR
  CONTRIBUTOR
  VIEWER
  EVENT_MANAGER
  MEDIA_OFFICE
  SUPERVISOR
  ASSISTANT
  STUDIES
  AUDITOR
  STUDIES_ASSESSOR
  STUDIES_HEAD
  LEGAL_DIRECTOR
  DEPUTY_MINISTER
  LICENSING_OFFICER
  LICENSING_COMMITTEE
  FINANCE
  DIRECTORATE
  // Door staff at an event venue. Scans ticket QR codes and records
  // attendance — and nothing else; deliberately the narrowest role in the
  // system, because these accounts are used on phones at a public entrance.
  TICKET_OFFICER
  // Proofreads the English side of cultural-calendar events and decides on
  // citizen identity submissions. Sees no other part of the panel: it may edit
  // an event but never create, delete, publish or approve one, and it reviews
  // identity documents without being able to block or erase an account.
  LANGUAGE_IDENTITY_REVIEWER
  // Scoped to exactly one CulturalCenter (User.assignedCenterId). Confirms a
  // copyright deposit copy arrived at their center and releases the
  // certificate — sees no other part of the panel.
  CULTURAL_CENTER_OFFICER
}

enum LegalLicenseType {
  CULTURAL_FORUM
  CULTURAL_HOUSE
  CULTURAL_ASSOCIATION
  AMATEUR_TROUPE
  CINEMA_ARTS
  FINE_ARTS
  HERITAGE_MUSEUM
  MUSIC_INSTITUTE
  THEATER_INSTITUTE
  FINE_ARTS_GALLERY
}

enum LegalLicenseStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  COMMITTEE_REVIEW
  SUSPENDED
  LEGAL_APPROVAL
  MINISTER_APPROVAL
  APPROVED
  REJECTED
  LICENSE_ISSUED
  COMPLETED
}

enum LegalLicenseAttachmentKind {
  NATIONAL_ID_FRONT
  NATIONAL_ID_BACK
  CRIMINAL_RECORD
  RESIDENCE_DOCUMENT
  PERSONAL_PHOTO
  AUTHORIZATION
  FOUNDERS_MINUTES
  ACTIVITY_PLAN
  OWNERSHIP_OR_LEASE
  FLOOR_PLAN
  SAFETY_APPROVAL
  ARTICLES_OF_ASSOCIATION
  MEMBERS_LIST
  ARTISTIC_PROGRAM
  PROFESSIONAL_CERTIFICATE
  EQUIPMENT_LIST
  ARTWORK_PORTFOLIO
  COLLECTION_INVENTORY
  COLLECTION_PROVENANCE
  ACADEMIC_QUALIFICATION
  PROGRAM_AND_CURRICULUM
  GALLERY_PROGRAM
  APPLICATION_PDF
  APPLICATION_DOCX
  BYLAWS_PDF
  BYLAWS_DOCX
  REQUIREMENTS_CHECKLIST_PDF
  TECHNICAL_SUMMARY_PDF
  ISSUED_LICENSE
}

enum LegalLicenseReviewStatus {
  PENDING
  ACCEPTED
  DEFICIENT
  NOT_APPLICABLE
}

enum PostStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  ARCHIVED
}

enum PostType {
  NEWS
  ANNOUNCEMENT
  ACHIEVEMENT
  PAGE
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

// Moderation state for calendar events. Events created by authority roles
// (those holding REVIEW_EVENT — admins, the festivals directorate) default to
// APPROVED and publish immediately. Events created by the DIRECTORATE role
// start as PENDING and only reach the public calendar once approved.
enum EventReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

// Per-service, per-year counter behind the human-readable reference numbers
// citizens see on their requests (e.g. OVS-2026-0042). One row per
// (scope, year); the sequence restarts each calendar year so the numbers stay
// short and match how the ministry files paperwork. See src/lib/reference-number.js.
model ReferenceCounter {
  scope     String
  year      Int
  seq       Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([scope, year])
}

model LegalLicenseApplication {
  id                        String                   @id @default(cuid())
  referenceNo               String?                  @unique
  accessTokenHash           String                   @unique
  applicantName             String?
  nationalId                String?
  phone                     String?
  email                     String?
  capacity                  String?
  licenseType               LegalLicenseType?
  entityName                String?
  purpose                   String?                  @db.Text
  objectives                String?                  @db.Text
  activityDescription       String?                  @db.Text
  governorate               String?
  address                   String?                  @db.Text
  status                    LegalLicenseStatus       @default(DRAFT)
  revision                  Int                      @default(1)
  declarationAccuracy       Boolean                  @default(false)
  declarationResponsibility Boolean                  @default(false)
  declarationPrivacy        Boolean                  @default(false)
  applicantSignature        String?                  @db.Text
  deficiencyNote            String?                  @db.Text
  committeeRecommendation   String?                  @db.Text
  ministerDecision          String?                  @db.Text
  licenseNumber             String?                  @unique
  licenseDate               DateTime?
  submittedAt               DateTime?
  issuedAt                  DateTime?
  completedAt               DateTime?
  archivedAt                DateTime?
  eligibilityAnswers        Json?
  premisesAnswers           Json?
  bylawAnswers              Json?
  postLicenseDeclarations   Json?
  managerDetails            Json?
  requirementSnapshot       Json?
  deficiencyScopes          Json?
  documentTemplateVersion   String?
  founders                  LegalLicenseFounder[]
  attachments               LegalLicenseAttachment[]
  history                   LegalLicenseHistory[]
  reviewItems               LegalLicenseReviewItem[]
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt

  @@index([status])
  @@index([referenceNo])
  @@index([accessTokenHash])
}

model LegalLicenseFounder {
  id                         String                   @id @default(cuid())
  applicationId              String
  application                LegalLicenseApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fullName                   String?
  nationalId                 String?
  birthDate                  DateTime?
  occupation                 String?
  qualification              String?
  phone                      String?
  email                      String?
  address                    String?                  @db.Text
  isAuthorizedRepresentative Boolean                  @default(false)
  attachments                LegalLicenseAttachment[]
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt

  @@unique([applicationId, nationalId])
  @@index([applicationId])
}

model LegalLicenseAttachment {
  id               String                     @id @default(cuid())
  applicationId    String
  application      LegalLicenseApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  founderId        String?
  founder          LegalLicenseFounder?       @relation(fields: [founderId], references: [id], onDelete: SetNull)
  kind             LegalLicenseAttachmentKind
  originalName     String
  mimeType         String
  size             Int
  storageKey       String                     @unique
  version          Int                        @default(1)
  templateVersion  String?
  verificationCode String?                    @unique
  generatedAt      DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@index([applicationId])
  @@index([founderId])
  @@index([kind])
}

model LegalLicenseHistory {
  id            String                  @id @default(cuid())
  applicationId String
  application   LegalLicenseApplication @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  actorId       String?
  actorEmail    String?
  actorName     String?
  actorRole     String?
  fromStatus    LegalLicenseStatus?
  toStatus      LegalLicenseStatus?
  action        String
  note          String?                 @db.Text
  publicNote    String?                 @db.Text
  createdAt     DateTime                @default(now())

  @@index([applicationId])
  @@index([createdAt])
}

model LegalLicenseReviewItem {
  id                  String                   @id @default(cuid())
  applicationId       String
  applicationRevision Int
  requirementKey      String
  scope               String
  subjectRef          String?
  status              LegalLicenseReviewStatus @default(PENDING)
  note                String?                  @db.Text
  publicNote          String?                  @db.Text
  reviewerId          String?
  reviewerEmail       String?
  reviewerName        String?
  reviewedAt          DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  application         LegalLicenseApplication  @relation(fields: [applicationId], references: [id], onDelete: Restrict)

  @@unique([applicationId, applicationRevision, requirementKey, subjectRef], map: "LLReview_app_revision_requirement_subject_key")
  @@index([applicationId, applicationRevision])
}

model EventKind {
  id        String   @id @default(cuid())
  nameAr    String   @unique
  nameEn    String?
  color     String   @default("#6C4A8F")
  events    Event[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                 String          @id @default(cuid())
  email              String          @unique
  password           String
  nameAr             String
  nameEn             String?
  role               Role            @default(AUTHOR)
  avatar             String?
  // Set only for CULTURAL_CENTER_OFFICER accounts — scopes that account to
  // exactly one cultural center's incoming copyright deliveries.
  assignedCenterId   String?
  assignedCenter     CulturalCenter? @relation(fields: [assignedCenterId], references: [id], onDelete: SetNull)
  isActive           Boolean         @default(true)
  // Set when an admin force-resets this user's password; the user is locked
  // out of the rest of the CMS until they set their own new password.
  mustChangePassword Boolean         @default(false)
  createdById        String?
  posts              Post[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

// Append-only security audit trail for sensitive admin actions
// (currently: forced password resets and self-service password changes).
// Actor/target identity is denormalized (id + email snapshot) so the trail
// stays meaningful even if a user account is later edited or deleted.
model AuditLog {
  id          String   @id @default(cuid())
  action      String
  actorId     String
  actorEmail  String
  targetId    String?
  targetEmail String?
  ipAddress   String?
  metadata    String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([action])
  @@index([actorId])
  @@index([targetId])
  @@index([createdAt])
}

model Post {
  id            String     @id @default(cuid())
  titleAr       String
  titleEn       String?
  contentAr     String?    @db.Text
  contentEn     String?    @db.Text
  summaryAr     String?
  summaryEn     String?
  slug          String     @unique
  status        PostStatus @default(DRAFT)
  type          PostType   @default(NEWS)
  featuredImage String?
  views         Int        @default(0)
  authorId      String
  author        User       @relation(fields: [authorId], references: [id])
  categoryId    String?
  category      Category?  @relation(fields: [categoryId], references: [id])
  tags          PostTag[]
  seoTitleAr    String?
  seoTitleEn    String?
  seoDescAr     String?
  seoDescEn     String?
  builderData   String?    @db.Text
  publishedAt   DateTime?
  gallery       String?    @db.Text
  attachments   String?    @db.Text
  facebookUrl   String?
  instagramUrl  String?
  twitterUrl    String?
  youtubeUrl    String?
  sourceUrl     String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Category {
  id     String  @id @default(cuid())
  nameAr String
  nameEn String?
  slug   String  @unique
  posts  Post[]
}

model Tag {
  id     String    @id @default(cuid())
  nameAr String
  nameEn String?
  slug   String    @unique
  posts  PostTag[]
}

model PostTag {
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model Event {
  id                   String                   @id @default(cuid())
  titleAr              String
  titleEn              String?
  descriptionAr        String?                  @db.Text
  descriptionEn        String?                  @db.Text
  location             String?
  locationEn           String?
  governorate          String?
  governorateEn        String?
  startDate            DateTime
  endDate              DateTime?
  featuredImage        String?
  status               EventStatus              @default(UPCOMING)
  eventCategoryId      String?
  eventCategory        EventCategory?           @relation(fields: [eventCategoryId], references: [id], onDelete: SetNull)
  eventKindId          String?
  eventKind            EventKind?               @relation(fields: [eventKindId], references: [id], onDelete: SetNull)
  // Moderation workflow (cultural-calendar review). Identity fields are
  // denormalized plain ids (no relation), mirroring AuditLog, so the trail
  // survives user edits/deletes and keeps migrations friction-free.
  reviewStatus         EventReviewStatus        @default(APPROVED)
  rejectionReason      String?                  @db.Text
  createdById          String?
  reviewedById         String?
  reviewedAt           DateTime?
  // External-sync provenance. Events mirrored from partner sites (currently the
  // Damascus Opera House) carry source="OPERA" plus the partner's own event id,
  // a booking deep-link back to the partner, and the last sync timestamp. The
  // (source, externalId) pair is unique so re-pushes upsert instead of dup.
  // Internal ministry events keep source="MOC" and leave externalId null.
  source               String                   @default("MOC")
  externalId           String?
  bookingUrl           String?
  syncedAt             DateTime?
  // ── Internal seat booking ──────────────────────────────────────────────
  // Most events never enable this (bookingAvailability defaults to
  // DISABLED); it exists alongside — and is mutually exclusive with — the
  // external bookingUrl above (an "OPERA"-sourced or bookingUrl-carrying
  // event must never also enable internal booking, enforced in the admin
  // API, not just here). bookedCount is a denormalized counter kept in sync
  // with EventBooking rows inside the same transaction as every write to
  // them — it is the capacity check's source of truth, periodically
  // reconciled against a COUNT(*) of CONFIRMED bookings.
  bookingAvailability  EventBookingAvailability @default(DISABLED)
  capacity             Int?
  bookedCount          Int                      @default(0)
  waitlistEnabled      Boolean                  @default(true)
  bookingOpensAt       DateTime?
  bookingClosesAt      DateTime?
  bookingNoteAr        String?                  @db.Text
  bookingNoteEn        String?                  @db.Text
  // English proofreading sign-off (LANGUAGE_IDENTITY_REVIEWER). Cleared
  // automatically whenever an English field changes afterwards — a tick that
  // survives a later edit would vouch for text nobody read. Denormalized
  // reviewer id, same as reviewedById above.
  languageReviewedAt   DateTime?
  languageReviewedById String?
  bookings             EventBooking[]
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@unique([source, externalId])
  @@index([reviewStatus])
  @@index([createdById])
  @@index([languageReviewedAt, startDate])
}

enum EventBookingAvailability {
  DISABLED // no internal booking for this event
  OPEN // accepting new bookings within the booking window
  CLOSED // existing bookings kept, no new ones
}

model EventCategory {
  id        String   @id @default(cuid())
  nameAr    String   @unique
  nameEn    String?
  color     String   @default("#1C665A")
  events    Event[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SubmissionStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  CONDITIONAL
  REJECTED
}

enum EntityType {
  DIRECTORATE
  GOVERNMENT
  EXTERNAL
  INDIVIDUAL
}

model EventSubmission {
  id                 String           @id @default(cuid())
  // Human-readable sequential reference (EVT-YYYY-NNNN) shown to the citizen and
  // used in correspondence. Nullable: rows created before the feature have none.
  referenceNo        String?          @unique
  applicantName      String
  directorate        String?
  phone              String?
  email              String?
  eventName          String
  entityType         EntityType       @default(INDIVIDUAL)
  entityName         String?
  description        String           @db.Text
  goals              String           @db.Text
  expectedImpact     String?          @db.Text
  targetAudience     String?
  governorate        String?
  culturalCenterId   String?
  proposedVenue      String?
  proposedDate       String?
  eventType          String?
  isSustainable      Boolean          @default(false)
  sustainabilityNote String?          @db.Text
  sponsorshipNeeded  String?
  sponsorshipNote    String?
  additionalNotes    String?          @db.Text
  agreedToTerms      Boolean          @default(false)
  status             SubmissionStatus @default(PENDING)
  adminNotes         String?          @db.Text
  dedupeKey          String?          @unique
  deletedAt          DateTime?
  deletedById        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([deletedAt])
}

model CulturalCenter {
  id          String                @id @default(cuid())
  nameAr      String
  governorate String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  submissions CopyrightSubmission[]
  officers    User[]

  @@unique([nameAr, governorate])
}

model Media {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  url          String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  altAr        String?
  altEn        String?
  uploadedById String
  createdAt    DateTime @default(now())
}

// In-app notifications surfaced in the admin topbar bell. Kept intentionally
// simple (no read-receipts table, no push integration) — just enough to turn
// the previously-decorative bell icon into a real, queryable inbox per user.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // e.g. "SUBMISSION_PENDING", "POST_PENDING_REVIEW", "PASSWORD_RESET"
  titleAr   String
  titleEn   String?
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, isRead])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  type      String   @default("string")
  group     String   @default("general")
  labelAr   String?
  labelEn   String?
  updatedAt DateTime @updatedAt
}

model CopyrightSubmission {
  id                         String             @id @default(cuid())
  // Public sequential reference (CPR-YYYY-NNNN) given to the citizen on submit.
  // Distinct from `internalRefNumber`, which the technical assessor assigns by
  // hand later in the review chain.
  referenceNo                String?            @unique
  applicantName              String
  applicantPhone             String
  applicantEmail             String
  applicantRole              String
  workTitle                  String
  workCategory               String
  workDesc                   String             @db.Text
  province                   String
  center                     String
  completionDate             String
  hasTelecomDoc              Boolean            @default(false)
  paymentStatus              String             @default("pending") // pending, initial_paid, fully_paid
  applicationStatus          String             @default("submitted") // draft, submitted, under_review, etc.
  applicantSignature         String?            @db.Text // Base64 signature image (optional)
  reviewerSignature          String?            @db.Text // Base64 reviewer signature image
  authors                    Json? // Array of joint authors: { name: String, signature: String, idLabel: String }
  paymentGateway             String?            @default("syriatel_cash")
  paymentRef                 String?
  payments                   CopyrightPayment[]
  paymentReceipt             String?            @db.Text
  commercialRegisterFile     String?            @db.Text
  delegationFile             String?            @db.Text
  representativeIdFile       String?            @db.Text
  originalOwnerIdFile        String?            @db.Text
  assessorReportFile         String?            @db.Text
  studiesRecommendationsFile String?            @db.Text
  // Shared, append-only review notes visible to the whole review chain
  // (Finance, Assessor, Studies Head, Legal Director, Deputy Minister).
  // Replaces the old per-stage report file uploads. Each entry:
  // { role, userId, name, text, at }.
  reviewNotes                Json?
  // Internal reference number entered by the technical assessor. Once set it is
  // locked: only the assessor who set it (internalRefSetById) or a SUPER_ADMIN
  // may change it.
  internalRefNumber          String?
  internalRefSetById         String?
  // Cultural-center delivery gate: the deposit copy is routed to the citizen's
  // nearest center before the certificate (paper or electronic) is released.
  // assignedCenterId is set when Finance dispatches (final_review →
  // pending_center_delivery); the rest are set together when the center
  // officer confirms arrival (pending_center_delivery → completed).
  assignedCenterId           String?
  assignedCenter             CulturalCenter?    @relation(fields: [assignedCenterId], references: [id], onDelete: SetNull)
  centerDeliveryMethod       String? // "paper" | "electronic"
  centerConfirmedAt          DateTime?
  centerConfirmedById        String?
  // What is missing, written by the reviewer who suspended the submission for
  // deficiencies. Shown to the citizen and emailed to them.
  deficiencyNote             String?            @db.Text
  workFile                   String?            @db.Text
  workDriveUrl               String?
  workOrigin                 String?
  originalWorkName           String?
  originalPermission         String?            @db.Text
  idDocType                  String             @default("national_id") // national_id (front+back) or passport (single page in idFileFront)
  idFileFront                String?            @db.Text
  idFileBack                 String?            @db.Text
  telecomFile                String?            @db.Text
  roleFile                   String?            @db.Text
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  @@unique([paymentRef])
  @@unique([internalRefNumber])
  @@index([assignedCenterId])
}

// Preserve both wallet transfers; a reference cannot pay two fees or cases.
model CopyrightPayment {
  id           String              @id @default(cuid())
  submissionId String
  submission   CopyrightSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  stage        String
  reference    String              @unique
  gateway      String
  receipt      String?             @db.Text
  verifiedAt   DateTime?
  rejectedAt   DateTime?
  createdAt    DateTime            @default(now())

  @@unique([submissionId, stage])
}

// ─────────────────────────────────────────────────────────────────────────────
// Citizen accounts (event seat booking)
//
// A Citizen is a public-facing account, structurally and permanently separate
// from User (CMS staff). The two must never be resolvable through the same
// code path — see src/lib/crypto.js's TOKEN_AUDIENCE and src/lib/citizen-dal.js.
// There is no CITIZEN Role; adding one would mix tens of thousands of public
// accounts into the same table the admin permission system assumes is
// entirely staff, turning any future permissions bug from contained to
// catastrophic.
// ─────────────────────────────────────────────────────────────────────────────

enum CitizenIdentityStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
}

model Citizen {
  id       String  @id @default(cuid())
  email    String  @unique
  password String
  fullName String
  phone    String?

  // The national ID is never stored in the clear: HMAC hash (keyed by
  // CITIZEN_ID_PEPPER) for uniqueness/lookup, plus the last 4 digits for
  // door-side visual verification. See src/lib/citizen-identity.mjs.
  //
  // Deliberately NOT @unique here — uniqueness is enforced only among
  // *verified* accounts, via a partial unique index added in this
  // migration's raw SQL (Citizen_verified_national_id_unique). An absolute
  // unique constraint would let one mistyped email or one SMTP failure at
  // registration permanently squat a citizen's national ID with an
  // unreachable account. See the migration file for the full rationale.
  nationalIdHash  String
  nationalIdLast4 String

  // Source of truth for email verification. Independent of identityStatus
  // below — a citizen may be logged in with a verified email while their
  // identity documents are still NOT_SUBMITTED, PENDING, or REJECTED.
  emailVerifiedAt DateTime?

  // Source of truth for identity-document verification. Independent of
  // isActive/isBlocked below — deliberately not folded into one combined
  // enum, since that would let two unrelated axes (identity review state vs.
  // operational ban) fight over the same field.
  identityStatus         CitizenIdentityStatus @default(NOT_SUBMITTED)
  identitySubmittedAt    DateTime?
  identityVerifiedAt     DateTime?
  identityVerifiedById   String?
  identityRejectedAt     DateTime?
  identityRejectedReason String?               @db.Text

  // Private storage keys (never public URLs) for the front/back ID photos.
  // See src/lib/citizen-identity-storage.mjs.
  identityFrontFileKey String?
  identityBackFileKey  String?

  isActive      Boolean @default(true)
  isBlocked     Boolean @default(false)
  blockedReason String? @db.Text

  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  lastLoginAt  DateTime?

  // Bumped on password change, "log out everywhere," and admin block. Every
  // citizen-session token carries the sessionVersion it was issued with;
  // src/lib/citizen-dal.js rejects any token whose value no longer matches
  // this column. There is no server-side session store, so this comparison
  // *is* the revocation mechanism.
  sessionVersion    Int      @default(1)
  passwordChangedAt DateTime @default(now())

  bookings  EventBooking[]
  emailOtps CitizenEmailOtp[]
  tokens    CitizenToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([emailVerifiedAt])
  @@index([identityStatus])
  @@index([isBlocked, isActive])
  @@index([nationalIdHash])
}

enum CitizenEmailOtpPurpose {
  EMAIL_VERIFICATION
  EMAIL_CHANGE
}

// Short-lived 6-digit email codes. Deliberately a separate table from
// CitizenToken below: codes are short, human-typed, and need an attempt
// counter; long tokens are single-use links and don't.
model CitizenEmailOtp {
  id        String  @id @default(cuid())
  citizenId String
  citizen   Citizen @relation(fields: [citizenId], references: [id], onDelete: Cascade)

  purpose  CitizenEmailOtpPurpose
  // HMAC(CITIZEN_OTP_SECRET, id + citizenId + purpose + code) — plain SHA-256
  // is not enough for a 6-digit space; a leaked table would be brute-forced
  // in seconds without the secret key. See src/lib/citizen-email-otp.js.
  codeHash String

  expiresAt  DateTime
  consumedAt DateTime?
  revokedAt  DateTime?

  attempts    Int @default(0)
  maxAttempts Int @default(5)

  sentAt        DateTime @default(now())
  ipHash        String?
  userAgentHash String?

  createdAt DateTime @default(now())

  @@index([citizenId, purpose, createdAt, id])
  @@index([expiresAt, consumedAt, revokedAt])
}

enum CitizenTokenPurpose {
  PASSWORD_RESET
  EMAIL_CHANGE_CONFIRMATION
}

// Long-lived single-use link tokens (password reset, email-change
// confirmation) — as opposed to the short 6-digit CitizenEmailOtp codes above.
model CitizenToken {
  id        String  @id @default(cuid())
  citizenId String
  citizen   Citizen @relation(fields: [citizenId], references: [id], onDelete: Cascade)

  purpose   CitizenTokenPurpose
  tokenHash String              @unique
  newEmail  String? // only set for EMAIL_CHANGE_CONFIRMATION

  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([citizenId, purpose, createdAt])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Event seat booking
// ─────────────────────────────────────────────────────────────────────────────

enum EventBookingStatus {
  CONFIRMED
  WAITLISTED
  CANCELLED
}

// Deliberately separate from EventBookingStatus: attendance is tracked
// independently so checking someone in never touches the seat-count logic
// or the active-booking uniqueness index, both of which key off `status`.
enum EventAttendanceStatus {
  NOT_CHECKED_IN
  ATTENDED
  NO_SHOW
}

enum EventBookingSource {
  CITIZEN // booked by the citizen from their own account
  ADMIN // walk-in / manually entered by staff
}

model EventBooking {
  id          String @id @default(cuid())
  referenceNo String @unique // BKG-YYYY-NNNN, see REFERENCE_SCOPES.BOOKING

  eventId String
  // Restrict, not Cascade: a booking is an attendance/audit record. Deleting
  // an event that has bookings must fail loudly (see
  // src/app/api/admin/events/[id]/route.js) rather than silently erasing
  // who was there — events with bookings are cancelled/archived, not deleted.
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Restrict)

  // Null for ADMIN-source walk-in bookings with no citizen account, and left
  // null (not deleted) if the citizen account is later removed — the booking
  // row is the historical/audit record and outlives the account.
  citizenId String?
  citizen   Citizen? @relation(fields: [citizenId], references: [id], onDelete: SetNull)

  // Snapshot of identity at booking time — not a live join to Citizen, so
  // the record stays meaningful even if the account's name/contact changes
  // or the account is deleted later. Same denormalization pattern as
  // AuditLog and Event's reviewedById/createdById.
  fullName        String
  nationalIdHash  String
  nationalIdLast4 String
  email           String?
  phone           String?

  status           EventBookingStatus    @default(CONFIRMED)
  attendanceStatus EventAttendanceStatus @default(NOT_CHECKED_IN)
  source           EventBookingSource    @default(CITIZEN)

  // HMAC(referenceNo + eventId + nationalIdHash, BOOKING_TICKET_SECRET) —
  // the reference number alone is not proof of a valid ticket; this signature
  // is what the door check actually verifies.
  ticketSig String

  cancelledAt        DateTime?
  cancelledBy        String? // "CITIZEN" or the staff member's id
  cancellationReason String?
  promotedAt         DateTime? // set when promoted from WAITLISTED to CONFIRMED
  checkedInAt        DateTime?
  checkedInById      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The real uniqueness guarantee — "one active booking per person per
  // event" — is a partial unique index added in this migration's raw SQL
  // (EventBooking_active_person_unique), scoped to status IN (CONFIRMED,
  // WAITLISTED). Prisma cannot express partial indexes, so it is not
  // declared here; see the migration file.
  @@index([eventId, status, createdAt, id])
  @@index([eventId, attendanceStatus])
  @@index([citizenId, createdAt])
  @@index([nationalIdHash])
}

// ─────────────────────────────────────────────────────────────────────────────
// Outbound notification queue
//
// Booking confirmation/waitlist/promotion/cancellation emails go through
// this table instead of being sent inline, so a database write that
// succeeds is never lost because SMTP happened to be down at that instant.
// A cron-triggered worker (POST /api/internal/process-notification-outbox)
// drains it with FOR UPDATE SKIP LOCKED. The one exception is the email
// verification OTP itself, which is sent synchronously — see
// CitizenEmailOtp's comment and plan section 11.1.
// ─────────────────────────────────────────────────────────────────────────────

enum NotificationOutboxStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model NotificationOutbox {
  id          String @id @default(cuid())
  type        String
  recipient   String
  payloadJson Json

  // Display columns for the admin email-audit screen. They are denormalized on
  // purpose: payloadJson can hold a base64 attachment, so the list must be able
  // to render a row without ever loading it.
  subject   String?
  kindAr    String? // "تأكيد استلام طلب"
  contextAr String? // "رسالة عبر نموذج «تواصل معنا»"

  status      NotificationOutboxStatus @default(PENDING)
  attempts    Int                      @default(0)
  maxAttempts Int                      @default(8)
  lastError   String?
  availableAt DateTime                 @default(now())
  lockedAt    DateTime?
  lockedBy    String?
  sentAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, availableAt, createdAt])
  @@index([createdAt(sort: Desc)])
}

// ─────────────────────────────────────────────────────────────────────────────
// Internal Oversight complaints and International Cooperation messages were
// previously email-only (see git history of their API routes): the request
// was mailed to a directorate inbox and nothing was kept in the database. If
// the mail send failed, or the inbox wasn't monitored, the submission simply
// vanished with no recovery path. These two models make every submission
// durable regardless of email outcome, and give staff an admin list to review.
// ─────────────────────────────────────────────────────────────────────────────

enum ComplaintStatus {
  NEW
  IN_REVIEW
  RESOLVED
  CLOSED
}

model OversightComplaint {
  id           String          @id @default(cuid())
  referenceNo  String?         @unique
  category     String
  isAnonymous  Boolean         @default(false)
  name         String?
  email        String?
  phone        String?
  against      String          @db.Text
  subject      String          @db.Text
  incidentDate String?
  message      String          @db.Text
  // [{ filename, mimeType, size, storageKey }] — images live under
  // private-uploads/oversight-complaints/<id>/, never in the DB itself.
  attachments  Json?
  status       ComplaintStatus @default(NEW)
  adminNote    String?         @db.Text
  emailSent    Boolean         @default(false)
  emailError   String?         @db.Text
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([status, createdAt])
}

model CooperationMessage {
  id          String          @id @default(cuid())
  referenceNo String?         @unique
  contactType String
  name        String
  email       String
  phone       String
  workplace   String
  subject     String          @db.Text
  message     String          @db.Text
  // [{ filename, mimeType, size, storageKey }] — images live under
  // private-uploads/cooperation-messages/<id>/, never in the DB itself.
  attachments Json?
  status      ComplaintStatus @default(NEW)
  adminNote   String?         @db.Text
  emailSent   Boolean         @default(false)
  emailError  String?         @db.Text
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status, createdAt])
}
