    "db:push": "prisma db push",
    "db:seed": "node prisma/seed.js",
    "db:seed-mock": "node prisma/seed-mock.js",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "booking:reconcile": "node --conditions=react-server --import ./src/lib/node-test-alias-hook.mjs scripts/reconcile-bookings.mjs",
